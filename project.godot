; Engine configuration file.
; Godot 4.3 — Ashen Road / Пепельный Тракт
config_version=5

[application]
config/name="Ashen Road"
config/description="Пепельный Тракт — тёмное фэнтези, пошаговый бой, экспедиция"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.047, 0.043, 0.039, 1)
boot_splash/show_image=false

[autoload]
Game="*res://scripts/game.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=900
window/size/min_height=560
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.047, 0.043, 0.039, 1)

[gui]
theme/custom_font=""
